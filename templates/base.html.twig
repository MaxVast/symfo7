<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}EventHub Enigma{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" integrity="sha384-xOolHFLEh07PJGoPkLv1IbcEPTNtaed2xpHsD9ESMhqIYd0nLMwNLD69Npy4HI+N" crossorigin="anonymous">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <nav class="navbar navbar-expand-lg bg-dark navbar-dark">
            <div class="container"><a class="navbar-brand" href="{{ path('homepage') }}">EventHub</a>
                <div class="navbar-nav ms-auto">
                    <a class="nav-link" href="{{ path('list-events') }}">Événements</a>
                    {% if app.user %}
                        <a class="nav-link" href="{#{{ path('account_registrations') }}#}">Mes inscriptions</a>
                        {% if is_granted('ROLE_ORGANIZER') %}
                            <a class="nav-link" href="{#{{ path('organizer_event_index') }}#}">Organisateur</a>
                        {% endif %}
                        {% if is_granted('ROLE_ADMIN') %}
                            <a class="nav-link" href="{#{{ path('admin_dashboard') }}#}">Admin</a>
                        {% endif %}
                            <a class="nav-link" href="{{ path('logout') }}">Déconnexion</a>
                    {% else %}
                        <a class="nav-link" href="{{ path('app_login') }}">Connexion</a>
                        <a class="nav-link" href="{{ path('inscription_user') }}">Inscription</a>
                    {% endif %}
                </div>
            </div>
        </nav>
        {% block body %}{% endblock %}
    </body>
</html>
