{% extends 'base.html.twig' %}

{% block title %} {{ parent() }} | Nos Evenements {% endblock %}

{% block body %}
    <div class="row">
        {% for event in events %}
            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    <div class="card-body"><h3 class="h5">{{ event.title }}</h3>
                        <p>{{ event.startAt|date('d/m/Y H:i') }}</p>
                        <a href="#">Détails →</a>
                    </div>
                </div>
            </div>
        {% else %}
            <p>Aucun événement publié.</p>
        {% endfor %}
    </div>

{% endblock %}
